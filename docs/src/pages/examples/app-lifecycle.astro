---
import DocsLayout from "../../layouts/DocsLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import PageNavigation from "../../components/PageNavigation.astro";

const readingState = `import ForgeObservers

let lifecycle = AppLifecycleObserver()

// Current state — .active, .inactive, or .background
let state = lifecycle.state

if state == .active {
    resumeTimer()
}`;

const subscribing = `for await state in lifecycle.stateStream {
    switch state {
    case .active:
        resumeTimer()
        await refreshDataIfNeeded()
    case .inactive:
        pauseTimer()
    case .background:
        saveState()
    }
}`;

const practicalExample = `import SwiftUI
import ForgeObservers

struct TimerView: View {
    let lifecycle: AppLifecycleObserving

    @State private var elapsedSeconds = 0
    @State private var isRunning = false

    var body: some View {
        VStack(spacing: 20) {
            Text("\\(elapsedSeconds)s")
                .font(.system(size: 64, design: .monospaced))

            HStack {
                Button(isRunning ? "Pause" : "Start") {
                    isRunning.toggle()
                }
                Button("Reset") {
                    elapsedSeconds = 0
                    isRunning = false
                }
            }
        }
        .task {
            // Auto-pause when app leaves foreground,
            // resume when it comes back
            for await state in lifecycle.stateStream {
                switch state {
                case .active:
                    if isRunning { startTicking() }
                case .inactive, .background:
                    stopTicking()
                }
            }
        }
    }

    private func startTicking() { /* ... */ }
    private func stopTicking() { /* ... */ }
}`;
---

<DocsLayout title="App Lifecycle" section="examples">
  <h1>App Lifecycle</h1>
  <p class="text-lg text-muted-foreground mt-1 mb-8">Basic usage of <code>AppLifecycleObserver</code> for reacting to foreground, inactive, and background transitions.</p>

  <h2>Reading Current State</h2>
  <p><code>AppLifecycleState</code> is an enum with three cases: <code>.active</code>, <code>.inactive</code>, and <code>.background</code>.</p>
  <CodeBlock code={readingState} title="Reading lifecycle state" />

  <h2>Subscribing to Changes</h2>
  <p>Use <code>stateStream</code> with a <code>switch</code> to handle each transition. The stream emits the current value on subscription.</p>
  <CodeBlock code={subscribing} title="Subscribing to stateStream" />

  <h2>Practical Example</h2>
  <p>A timer that automatically pauses when the app goes to the background and resumes when it returns to the foreground.</p>
  <CodeBlock code={practicalExample} title="TimerView.swift" />

