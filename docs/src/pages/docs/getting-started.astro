          <th class="py-2 pr-4 text-left font-medium text-muted-foreground">Protocol</th>
          <th class="py-2 pr-4 text-left font-medium text-muted-foreground">Model</th>
          <th class="py-2 text-left font-medium text-muted-foreground">Stream</th>
